{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,data/**,src/data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-comments",
      "schedule": "*/10 * * * *"
    }
  ]
}