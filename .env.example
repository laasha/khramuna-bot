# პორტი
PORT=3000

# Meta (Facebook) კონფიგურაცია
# FB_VERIFY_TOKEN: ნებისმიერი საიდუმლო სიტყვა, რომელსაც ჩაწერთ Meta Developer პანელშიც
FB_VERIFY_TOKEN=khramuna_secret_verify_token

# FB_PAGE_ACCESS_TOKEN: Meta Developer პანელიდან დაგენერირებული გვერდის ტოკენი
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# Google Gemini API გასაღები (ინტელექტუალური პასუხებისა და შეკვეთის ამოცნობისთვის)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram შეტყობინებები მფლობელისთვის / კურიერისთვის (არასავალდებულო, მაგრამ რეკომენდებული)
# მიიღება @BotFather-ისგან
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# თქვენი პირადი ან ჯგუფის Chat ID (მიიღება @userinfobot-ისგან)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
